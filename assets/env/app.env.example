# Copy to assets/env/app.env (git-ignored) and adjust. Every value is documented in lib/env.dart.
# This file ships inside the app: never put secrets here.

# pamplemousse API. Android emulator: http://10.0.2.2:5064
API_BASE_URL=http://localhost:5064

# Defaults for a new traveller (ISO country code, ISO currency code).
DEFAULT_PASSPORT=LB
DEFAULT_CURRENCY=USD

# Firebase sign-in (ADR 0020): Firebase console → Project settings → Your apps. Public app settings, not secrets.
# Leave empty and the app opens on Welcome saying sign-in isn't set up.
FIREBASE_PROJECT_ID=travelgenie-1fdd1
FIREBASE_AUTH_DOMAIN=travelgenie-1fdd1.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_ANDROID_API_KEY=
